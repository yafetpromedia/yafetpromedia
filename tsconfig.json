{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./frontend/src/*"],
      "@backend/*": ["./backend/*"],
      "@db": ["./db/index.ts"]
    }
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "backend/**/*.ts", "db/**/*.ts"],
  "exclude": ["node_modules", "frontend/.next", "frontend/node_modules"]
}
